# ================================
# SmartRecruit Environment Configuration
# ================================

# --- Django Security & System ---
SECRET_KEY=django-insecure-your-production-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database Settings (MySQL 8.0 Default) ---
DB_NAME=smartrecruit
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# --- Groq AI API (Backend Only) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Email Service Configuration ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@smartrecruit.com

# --- Storage Settings ---
MEDIA_URL=media/
STATIC_URL=static/

# --- JWT / Session Authentication ---
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=1

# --- CORS & API Security ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
